# ---------------------------------------------------------------------------
# Secrets - never commit real keys. Copy .env.example to .env locally.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Virtual environment (recreate with: python -m venv RAGenv)
# ---------------------------------------------------------------------------
RAGenv/
venv/
.venv/
env/

# ---------------------------------------------------------------------------
# Python caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ---------------------------------------------------------------------------
# Trained model weights (~537 MB) - regenerate: scripts/train_classifier.py
# ---------------------------------------------------------------------------
models/

# ---------------------------------------------------------------------------
# Qdrant: the server binary (85 MB) and its on-disk storage (~3.5 GB).
# Download the binary per README; rebuild indexes with scripts/build_index.py
# and scripts/build_scale_index.py.
# ---------------------------------------------------------------------------
tools/qdrant/
data/qdrant_storage/

# ---------------------------------------------------------------------------
# Data artifacts. All of these are regenerated by the pipeline scripts and are
# either too large for git or are third-party dataset text we should not
# redistribute. Only the curated methods bibliography is tracked.
#   - scale corpus:      scripts/run_ingest.py --scale   (~1.3 GB)
#   - benchmark corpora: scripts/build_benchmarks.py     (HotpotQA, MultiHop-RAG)
#   - necessity labels:  scripts/make_labels.py
#   - LLM cache:         rebuilt on demand (11k small files)
# ---------------------------------------------------------------------------
data/*
!data/.gitkeep
!data/methods_bibliography.json

# ---------------------------------------------------------------------------
# Run logs - machine-specific, and they embed local absolute paths.
# ---------------------------------------------------------------------------
*.log
*.err
*.out

# ---------------------------------------------------------------------------
# Local agent / editor state
# ---------------------------------------------------------------------------
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Project hand-off notes kept local by request
# ---------------------------------------------------------------------------
CLAUDE.md
PROGRESS.md
